{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ],
  "env": {
    "DEFAULT_LANG": "fa-IR",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1"
  }
}
